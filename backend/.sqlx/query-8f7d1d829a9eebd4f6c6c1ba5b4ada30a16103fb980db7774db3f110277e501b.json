  "query": "INSERT INTO refresh_tokens (user_id, token_hash, expires_at)\n               SELECT id, $2::bytea, $3::timestamptz FROM users\n               WHERE id = $1 AND password_hash = $4\n               FOR SHARE\n               RETURNING id, user_id, expires_at, revoked_at, replaced_at",
