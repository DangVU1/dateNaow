# Copy to .env for local development. Never commit .env.
# 127.0.0.1 rather than localhost: on Windows, localhost tries ::1 first and
# waits ~2 s per new connection before falling back to IPv4.
DATABASE_URL=postgres://datenaow:datenaow@127.0.0.1:5432/datenaow
BIND_ADDR=0.0.0.0:8080
APP_BASE_URL=http://localhost:5173
# Optional; requests running longer get 408 (default 15).
# REQUEST_TIMEOUT_SECS=15
# HS256 secret for access tokens, at least 32 bytes. DEV-ONLY placeholder:
# use a long random value anywhere else (e.g. `openssl rand -base64 48`).
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
# Optional; access-token lifetime in seconds (default 900).
# ACCESS_TOKEN_TTL_SECS=900
# Optional; refresh-token lifetime in days, 1 to 365 (default 30).
# REFRESH_TOKEN_TTL_DAYS=30
# Optional Argon2id cost (defaults: 19456 KiB, 2 passes, 1 lane).
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1
# Adds `Secure` to the refresh cookie (default true). false only for plain-HTTP dev.
COOKIE_SECURE=false
# Read the client IP from X-Forwarded-For (default false). Set true only behind
# a reverse proxy that appends the real client address.
# TRUST_PROXY=false
RUST_LOG=info,datenaow=debug
